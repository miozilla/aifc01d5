{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "Deny Incorrect AWS KMS Keys or encryption key types",
			"Effect": "Deny",
			"Principal": "*",
			"Action": "s3:PutObject",
			"Resource": "[PASTE_BUCKET_ARN]/*",
			"Condition": {
				"StringNotEquals": {
					"s3:x-amz-server-side-encryption-aws-kms-key-id": "PASTE_LAB_KMS_KEY_ARN"
				}
			}
		}
	]
}